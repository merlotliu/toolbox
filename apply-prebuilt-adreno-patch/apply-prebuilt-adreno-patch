#!/bin/bash
# apply-prebuilt-adreno-patch
#
# Stage a Qualcomm auto-a7xbins drop into a temporary prebuilt_HY11-style
# directory tree, then delegate to apply-prebuilt-patch for the actual patch
# application.
#
# Steps:
#   1. Copy files from -s (auto-a7xbins layout) into a tmpdir that mirrors
#      the nhlos prebuilt_HY11/sa8797/adreno directory structure.
#   2. Run:  apply-prebuilt-patch -s <tmpdir> -d <dest_root> -t adreno [flags]
#
# Usage:
#   apply-prebuilt-adreno-patch -s PATCH_SRC [-d DEST_ROOT] [-p STAGE_PARENT]
#                               [--check-only|--only-check|--only-check-tar]
#                               [--skip-new] [-y]
#
#   -s PATCH_SRC    root of the Qualcomm auto-a7xbins drop
#                   e.g. ~/Downloads/auto-a7xbins_.../auto-a7xbins
#   -d DEST_ROOT    prebuilt_HY11 directory in the source tree (optional)
#                   default: /home/lixiang/Workspace/xref/W-8797-MASTER/nhlos/apps/apps_proc/prebuilt_HY11
#   -p STAGE_PARENT parent directory for the staging area (optional)
#                   default: /tmp
#                   The staged layout will be:
#                     <STAGE_PARENT>/sa8797/adreno/
#                     <STAGE_PARENT>/sa8797-fts/adreno/  (copy of sa8797)
#                   <STAGE_PARENT> is passed directly to apply-prebuilt-patch
#                   as -s and is NOT removed after the script exits.
#
#   --only-check / --check-only
#                   Passed through to apply-prebuilt-patch (pre-apply check only).
#   --only-check-tar
#                   Passed through to apply-prebuilt-patch (tar MD5 check only).
#   --skip-new      Passed through to apply-prebuilt-patch; do not apply files
#                   that are present in the patch but absent in dest.
#   -y / --yes      Passed through to apply-prebuilt-patch (skip confirmation).

set -euo pipefail

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
DEFAULT_DEST_ROOT="/home/lixiang/Workspace/xref/W-8797-MASTER/nhlos/apps/apps_proc/prebuilt_HY11"
DEFAULT_STAGE_PARENT="/tmp"

PATCH_SRC=""
DEST_ROOT=""
STAGE_PARENT=""
PASSTHROUGH=()

usage() {
    echo "Usage: $(basename "$0") -s PATCH_SRC [-d DEST_ROOT] [-p STAGE_PARENT] [--check-only|--only-check|--only-check-tar] [--skip-new] [-y]" >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -s) PATCH_SRC="$2";    shift 2 ;;
        -d) DEST_ROOT="$2";    shift 2 ;;
        -p) STAGE_PARENT="$2"; shift 2 ;;
        --only-check|--check-only) PASSTHROUGH+=("$1"); shift ;;
        --only-check-tar)          PASSTHROUGH+=("$1"); shift ;;
        --skip-new)                PASSTHROUGH+=("$1"); shift ;;
        -y|--yes)                  PASSTHROUGH+=("$1"); shift ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

[[ -z "$PATCH_SRC" ]] && usage

PATCH_SRC="$(realpath "$PATCH_SRC")"
DEST_ROOT="${DEST_ROOT:-$DEFAULT_DEST_ROOT}"
STAGE_PARENT="${STAGE_PARENT:-$DEFAULT_STAGE_PARENT}"

mkdir -p "$STAGE_PARENT"

echo "Patch source  : $PATCH_SRC"
echo "Dest root     : $DEST_ROOT"
echo "Stage parent  : $STAGE_PARENT"
echo

# ---------------------------------------------------------------------------
# Staging directory  (<STAGE_PARENT>/sa8797/adreno) – NOT removed on exit
# ---------------------------------------------------------------------------
STAGE="$STAGE_PARENT/sa8797/adreno"

# Clean up any previous staging run under this parent so stale files
# from a prior drop don't pollute the current one.
rm -rf "$STAGE_PARENT/sa8797" "$STAGE_PARENT/sa8797-fts"
mkdir -p "$STAGE"

echo "========================================"
echo " STEP 1: STAGE FILES INTO TMPDIR"
echo "========================================"
echo "Staging to : $STAGE"
echo

# stage_file <src_file> <dst_dir> [dst_filename]
stage_file() {
    local src="$1"
    local dst_dir="$2"
    local dst_name="${3:-$(basename "$src")}"
    if [[ ! -f "$src" ]]; then
        echo "  WARN: source file not found, skipping: $src"
        return
    fi
    mkdir -p "$dst_dir"
    cp "$src" "$dst_dir/$dst_name"
    echo "  cp  ${src#$PATCH_SRC/}  ->  ${dst_dir#$STAGE_PARENT/}/$dst_name"
}

# stage_dir <src_dir> <dst_dir>
stage_dir() {
    local src_dir="$1"
    local dst_dir="$2"
    while IFS= read -r -d '' f; do
        local rel="${f#$src_dir/}"
        stage_file "$f" "$dst_dir/$(dirname "$rel")" "$(basename "$rel")"
    done < <(find "$src_dir" -type f -print0)
}

# 1. Libraries  vendor/lib64/*.so  ->  usr/lib/
for f in "$PATCH_SRC"/vendor/lib64/*.so; do
    stage_file "$f" "$STAGE/usr/lib"
done

# 2. pkg-config  vendor/lib64/pkgconfig/*.pc  ->  usr/lib/pkgconfig/
for f in "$PATCH_SRC"/vendor/lib64/pkgconfig/*.pc; do
    stage_file "$f" "$STAGE/usr/lib/pkgconfig"
done

# 3. Firmware  vendor/firmware/*  ->  usr/lib/firmware/
for f in "$PATCH_SRC"/vendor/firmware/*; do
    [[ -f "$f" ]] && stage_file "$f" "$STAGE/usr/lib/firmware"
done

# 4. Executables  vendor/bin/*  ->  usr/bin/
for f in "$PATCH_SRC"/vendor/bin/*; do
    [[ -f "$f" ]] && stage_file "$f" "$STAGE/usr/bin"
done

# 5. Vulkan ICD  vendor/vulkan/icd.d/*  ->  etc/vulkan/icd.d/
for f in "$PATCH_SRC"/vendor/vulkan/icd.d/*; do
    [[ -f "$f" ]] && stage_file "$f" "$STAGE/etc/vulkan/icd.d"
done

# 6. Adreno config  vendor/adreno/*  ->  etc/adreno/
for f in "$PATCH_SRC"/vendor/adreno/*; do
    [[ -f "$f" ]] && stage_file "$f" "$STAGE/etc/adreno"
done

# 7. systemd service units  ->  usr/lib/systemd/system/
SYSTEMD="$STAGE/usr/lib/systemd/system"
for svc in kgsl@.service kgsl.service adreno_test.service gsl_hab_server.service; do
    stage_file "$PATCH_SRC/$svc" "$SYSTEMD"
done

# 8. systemd drop-in confs  ->  sleep-notify@kgsl@{0,1}.service.d/
stage_file "$PATCH_SRC/kgsl@0.conf" "$SYSTEMD/sleep-notify@kgsl@0.service.d" "kgsl@0.conf"
stage_file "$PATCH_SRC/kgsl@1.conf" "$SYSTEMD/sleep-notify@kgsl@1.service.d" "kgsl@1.conf"

# 9. sysusers  ->  usr/lib/sysusers.d/
stage_file "$PATCH_SRC/graphics-sysusers.conf" "$STAGE/usr/lib/sysusers.d"

# 10. Headers
stage_file "$PATCH_SRC/include/c2dExt.h"            "$STAGE/usr/include"
stage_file "$PATCH_SRC/include/gsl_profiler.h"      "$STAGE/usr/include"
stage_file "$PATCH_SRC/include/private/C2D/c2d2.h" "$STAGE/usr/include" "c2d2.h"
for subdir in CL EGL GLES GLES2 GLES3 KHR; do
    [[ -d "$PATCH_SRC/include/public/$subdir" ]] && \
        stage_dir "$PATCH_SRC/include/public/$subdir" "$STAGE/usr/include/$subdir"
done

echo

# ---------------------------------------------------------------------------
# Duplicate sa8797/adreno into sa8797-fts/adreno (same binaries for both).
# ---------------------------------------------------------------------------
cp -r "$STAGE_PARENT/sa8797/adreno" "$STAGE_PARENT/sa8797-fts/adreno"

# ---------------------------------------------------------------------------
# Step 2: delegate to apply-prebuilt-patch
# ---------------------------------------------------------------------------
echo "========================================"
echo " STEP 2: APPLY VIA apply-prebuilt-patch"
echo "========================================"
echo "  apply-prebuilt-patch -s $STAGE_PARENT -d $DEST_ROOT -t adreno${PASSTHROUGH:+ ${PASSTHROUGH[*]}}"
echo

apply-prebuilt-patch -s "$STAGE_PARENT" -d "$DEST_ROOT" -t adreno "${PASSTHROUGH[@]}"
