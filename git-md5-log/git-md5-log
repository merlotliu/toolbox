#!/usr/bin/env python3

import argparse
import hashlib
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


COMMIT_MARKER = "__COMMIT__"
MD5_RE = re.compile(r"^[0-9a-fA-F]{32}$")


@dataclass
class CommitEntry:
    commit_hash: str
    author_date: str
    author_name: str
    subject: str
    path_at_commit: str
    name_status_lines: list[str]


def run_git(repo_root: Path, *args: str, check: bool = True, text: bool = True, input_data=None):
    result = subprocess.run(
        ["git", "-C", str(repo_root), *args],
        input=input_data,
        capture_output=True,
        text=text,
    )
    if check and result.returncode != 0:
        stderr = result.stderr.strip() or result.stdout.strip() or "git command failed"
        raise RuntimeError(stderr)
    return result


def parse_args():
    parser = argparse.ArgumentParser(
        description="Find git commits for a library path whose file content matches the given md5.",
    )
    parser.add_argument("-p", "--path", required=True, help="Absolute or relative path to the library file")
    parser.add_argument("-m", "--md5", required=True, help="Target md5 checksum")
    return parser.parse_args()


def resolve_repo_and_relpath(file_path: Path) -> tuple[Path, str]:
    target = file_path.resolve()
    if not target.exists():
        raise RuntimeError(f"File not found: {target}")

    repo_root = run_git(target.parent, "rev-parse", "--show-toplevel").stdout.strip()
    if not repo_root:
        raise RuntimeError(f"Not inside a git repository: {target}")

    repo_root_path = Path(repo_root)
    relpath = target.relative_to(repo_root_path).as_posix()
    return repo_root_path, relpath


def collect_commit_entries(repo_root: Path, relpath: str) -> list[CommitEntry]:
    output = run_git(
        repo_root,
        "log",
        "--follow",
        "--date=iso-strict",
        f"--format={COMMIT_MARKER}%n%H%n%ad%n%an%n%s",
        "--name-status",
        "--",
        relpath,
    ).stdout

    entries: list[CommitEntry] = []
    current_path = relpath
    blocks = [block.strip() for block in output.split(COMMIT_MARKER) if block.strip()]
    for block in blocks:
        lines = [line for line in block.splitlines() if line.strip()]
        if len(lines) < 4:
            continue

        commit_hash, author_date, author_name, subject = lines[:4]
        name_status_lines = lines[4:]
        path_at_commit = current_path

        for line in name_status_lines:
            parts = line.split("\t")
            if not parts:
                continue
            status = parts[0]
            if status.startswith("R") and len(parts) >= 3 and parts[2] == current_path:
                path_at_commit = current_path
                current_path = parts[1]
                break

        entries.append(
            CommitEntry(
                commit_hash=commit_hash,
                author_date=author_date,
                author_name=author_name,
                subject=subject,
                path_at_commit=path_at_commit,
                name_status_lines=name_status_lines,
            )
        )

    return entries


def blob_md5(repo_root: Path, commit_hash: str, relpath: str) -> str | None:
    result = run_git(repo_root, "show", f"{commit_hash}:{relpath}", check=False, text=False)
    if result.returncode != 0:
        return None
    return hashlib.md5(result.stdout).hexdigest()


def render_commit(repo_root: Path, entry: CommitEntry, matched_md5: str) -> str:
    show_output = run_git(
        repo_root,
        "show",
        "--stat",
        "--summary",
        "--format=fuller",
        "--no-patch",
        entry.commit_hash,
    ).stdout.rstrip()
    status_section = "\n".join(entry.name_status_lines) if entry.name_status_lines else "(no name-status details)"
    return (
        f"Matched path: {entry.path_at_commit}\n"
        f"Matched md5 : {matched_md5}\n"
        f"Name-status  :\n{status_section}\n\n"
        f"{show_output}"
    )


def main() -> int:
    args = parse_args()
    if not MD5_RE.fullmatch(args.md5):
        print(f"Invalid md5: {args.md5}", file=sys.stderr)
        return 2

    try:
        repo_root, relpath = resolve_repo_and_relpath(Path(args.path))
        entries = collect_commit_entries(repo_root, relpath)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1

    matches: list[str] = []
    target_md5 = args.md5.lower()
    for entry in entries:
        current_md5 = blob_md5(repo_root, entry.commit_hash, entry.path_at_commit)
        if current_md5 == target_md5:
            matches.append(render_commit(repo_root, entry, current_md5))

    if not matches:
        print(
            f"No matching commits found for {relpath} with md5 {target_md5}",
            file=sys.stderr,
        )
        return 1

    print(f"Repository   : {repo_root}")
    print(f"Library path : {relpath}")
    print(f"Target md5   : {target_md5}")
    print(f"Matches found: {len(matches)}")
    print()
    for index, rendered in enumerate(matches, start=1):
        print(f"===== Match {index} =====")
        print(rendered)
        print()

    return 0


if __name__ == "__main__":
    sys.exit(main())
