#!/bin/bash

#
# monkey - Android monkey 压力测试
#

_script="${BASH_SOURCE[0]}"
while [ -L "$_script" ]; do _script="$(readlink "$_script")"; done
readonly TOOL_DIR="$(cd "$(dirname "$_script")" && pwd)"
readonly BLACKLIST="$TOOL_DIR/blacklist.txt"

show_usage() {
    cat << USAGE
monkey - Android monkey 压力测试

Usage: $(basename "$0") [-s <serial>] [-h]

OPTIONS:
    -s <serial>   指定设备序列号 (未指定时自动检测或交互选择)
    -h            显示帮助信息

EXAMPLES:
    $(basename "$0")
    $(basename "$0") -s 12345abcde
USAGE
}

SERIAL=""

while getopts "s:h" opt; do
    case $opt in
        s) SERIAL="$OPTARG" ;;
        h) show_usage; exit 0 ;;
        \?) echo "Error: Invalid option: -$OPTARG. Use -h for help." >&2; exit 1 ;;
    esac
done

if [ -z "$SERIAL" ]; then
    IFS=$'\n' read -r -d '' -a DEVICES < <(adb devices | awk 'NR>1 && $2=="device" {print $1}' && printf '\0')
    if [ ${#DEVICES[@]} -eq 0 ]; then
        echo "Error: 未检测到已连接的设备。" >&2
        exit 1
    elif [ ${#DEVICES[@]} -eq 1 ]; then
        SERIAL="${DEVICES[0]}"
        echo "已自动选择设备: $SERIAL"
    else
        echo "检测到多个设备，请选择："
        for i in "${!DEVICES[@]}"; do
            echo "  $((i+1))) ${DEVICES[$i]}"
        done
        while true; do
            read -rp "请输入序号 [1-${#DEVICES[@]}]: " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#DEVICES[@]}" ]; then
                SERIAL="${DEVICES[$((choice-1))]}"
                break
            fi
            echo "无效输入，请重试。"
        done
        echo "已选择设备: $SERIAL"
    fi
fi

echo "########################"
echo "###### monkey 压力测试 ######"
echo "###### by LI-AUTO Test TEAM ######"
echo "########################"

current_date=$(date +"%Y%m%d")

adb -s "$SERIAL" root
adb -s "$SERIAL" remount
adb -s "$SERIAL" push "$BLACKLIST" /data/local/tmp/

sleep 3

while true; do
    adb -s "$SERIAL" shell monkey \
        -d 6 \
        --pkg-blacklist-file /data/local/tmp/blacklist.txt \
        --ignore-crashes \
        --ignore-timeouts \
        --ignore-native-crashes \
        --pct-motion 45 \
        --pct-touch 45 \
        --pct-appswitch 10 \
        --pct-nav 0 \
        --pct-majornav 0 \
        --pct-syskeys 0 \
        --pct-anyevent 0 \
        --kill-process-after-error \
        -s "$current_date" \
        -v -v -v \
        --throttle 300 \
        600000000
done
